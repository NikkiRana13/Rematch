# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (production mode). Leave all three empty to use the local demo. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (optional). Without a key, reasoning analysis is rule-based and labelled as such. ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Set to "off" to disable the server-side refusal fallback (`fallbacks: "default"`).
ANTHROPIC_FALLBACKS=on

# --- Local demo only ---
# Allow the local demo in a production build (e.g. `next start` on a presentation laptop).
# Has no effect when Supabase is configured.
REMATCH_ALLOW_LOCAL_DEMO=false
# Optional secret for signing local demo host cookies (auto-generated in .data/ if unset).
REMATCH_DEMO_SECRET=
